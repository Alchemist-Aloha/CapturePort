# Maintainer: CapturePort contributors
pkgname=captureport
pkgver=0.1.0
pkgrel=1
pkgdesc='Linux photo and video ingest application'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('glib2' 'gtk3' 'libxkbcommon' 'wayland' 'libgphoto2' 'libxcb')
makedepends=('cargo' 'rust')
options=(!lto)
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  cargo build --locked --release --package captureport
}

package() {
  install -Dm755 "$startdir/../target/release/captureport" "$pkgdir/usr/bin/captureport"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/captureport.desktop" \
    "$pkgdir/usr/share/applications/captureport.desktop"
}
