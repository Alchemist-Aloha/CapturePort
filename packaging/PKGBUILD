# Maintainer: CapturePort contributors
pkgname=captureport
pkgver=${CAPTUREPORT_VERSION:-0.2.0}
pkgrel=1
pkgdesc='Linux photo and video ingest application'
arch=('x86_64' 'aarch64')
license=('MIT' 'OFL-1.1' 'Apache-2.0')
depends=('glib2' 'gtk3' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libgphoto2' 'libxcb' 'fontconfig' 'freetype2' 'vulkan-icd-loader')
makedepends=('cargo' 'rust')
options=(!lto)
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  cargo build --locked --release --package captureport
}

package() {
  install -Dm755 "$startdir/../target/release/captureport" "$pkgdir/usr/bin/captureport"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/../crates/captureport/assets/fonts/Outfit-OFL.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/Outfit-OFL.txt"
  install -Dm644 "$startdir/../crates/captureport/assets/icons/LICENSE.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/Apache-2.0-Material-Symbols.txt"
  install -Dm644 "$startdir/captureport.desktop" \
    "$pkgdir/usr/share/applications/captureport.desktop"
  install -Dm644 "$startdir/../crates/captureport/assets/captureport.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/captureport.svg"
}
